<!-- StartupUri ensures the main operator window opens on launch in Phase 1. -->
<Application x:Class="ProjectorLayout.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <!-- Shared application resources are intentionally empty in Phase 1 scaffold. -->
    </Application.Resources>
</Application>
