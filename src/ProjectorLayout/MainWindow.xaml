<Window x:Class="ProjectorLayout.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="ProjectorLayout"
        Height="800"
        Width="1200"
        MinHeight="600"
        MinWidth="900">
    <DockPanel>
        <!-- Main menu containing core operator actions for project and asset workflows. -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_New" Click="OnNewProjectClick" />
                <MenuItem Header="_Open" Click="OnOpenProjectClick" />
                <MenuItem Header="_Save" Click="OnSaveProjectClick" />
                <Separator />
                <MenuItem Header="E_xit" Click="OnExitClick" />
            </MenuItem>
            <MenuItem Header="_Assets">
                <MenuItem Header="Load _Background Image" Click="OnLoadImageClick" />
                <MenuItem Header="Load _DXF" Click="OnLoadDxfClick" />
            </MenuItem>
            <MenuItem Header="_Projection">
                <MenuItem Header="Start Projection" Click="OnStartProjectionClick" />
            </MenuItem>
        </Menu>

        <Grid>
            <Grid.ColumnDefinitions>
                <!-- Left column is reserved for explicit manual controls and status readouts. -->
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="12">
                    <TextBlock FontSize="18"
                               FontWeight="Bold"
                               Text="Projector Controls" />

                    <GroupBox Header="Manual Transform"
                              Margin="0,12,0,0">
                        <StackPanel Margin="8">
                            <TextBlock Text="Translate X" />
                            <TextBox Text="{Binding OverlayTransform.TranslateX, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Margin="0,8,0,0" Text="Translate Y" />
                            <TextBox Text="{Binding OverlayTransform.TranslateY, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Margin="0,8,0,0" Text="Scale" />
                            <TextBox Text="{Binding OverlayTransform.Scale, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Margin="0,8,0,0" Text="Rotation Degrees" />
                            <TextBox Text="{Binding OverlayTransform.RotationDegrees, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Projection Visuals"
                              Margin="0,12,0,0">
                        <StackPanel Margin="8">
                            <CheckBox Content="Show Grid"
                                      IsChecked="{Binding ShowGrid}" />
                            <CheckBox Margin="0,6,0,0"
                                      Content="Show Center Crosshair"
                                      IsChecked="{Binding ShowCenterCrosshair}" />

                            <TextBlock Margin="0,8,0,0" Text="Opacity" />
                            <Slider Minimum="0"
                                    Maximum="1"
                                    SmallChange="0.01"
                                    Value="{Binding OverlayOpacity}" />

                            <TextBlock Margin="0,8,0,0" Text="Brightness" />
                            <Slider Minimum="0.1"
                                    Maximum="2.0"
                                    SmallChange="0.05"
                                    Value="{Binding BrightnessMultiplier}" />
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="Calibration"
                              Margin="0,12,0,0">
                        <StackPanel Margin="8">
                            <TextBlock Text="Workflow order: UL, UR, LR, LL" />
                            <TextBlock Margin="0,4,0,0"
                                       Text="{Binding CalibrationStatus}" />
                            <Button Margin="0,8,0,0"
                                    Content="Reset Calibration"
                                    Click="OnResetCalibrationClick" />
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>

            <!-- Right panel is the editor surface where background and overlay are composited. -->
            <Border Grid.Column="1"
                    Margin="12"
                    BorderBrush="#444"
                    BorderThickness="1"
                    Background="#111">
                <Grid>
                    <!-- Background image layer. -->
                    <Image Source="{Binding BackgroundImage}"
                           Stretch="Uniform" />

                    <!-- Overlay visualization layer. Placeholder polyline and frame for safe startup. -->
                    <Canvas Background="Transparent">
                        <Rectangle Stroke="Lime"
                                   StrokeThickness="2"
                                   Width="300"
                                   Height="200"
                                   Canvas.Left="50"
                                   Canvas.Top="50"
                                   Opacity="{Binding OverlayOpacity}" />
                    </Canvas>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
