<Window x:Class="ProjectorLayout.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="ProjectorLayout"
        Height="800"
        Width="1200"
        MinHeight="600"
        MinWidth="900"
        WindowStartupLocation="CenterScreen">
    <!-- Phase 2 layout: control panel for commands and editor surface with image + overlay layers. -->
    <Grid Background="#1E1E1E">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Control panel region that hosts image-loading controls. -->
        <Border Grid.Column="0"
                x:Name="ControlPanelRegion"
                Margin="12"
                Padding="12"
                Background="#2C2C2C"
                BorderBrush="#4A4A4A"
                BorderThickness="1"
                CornerRadius="6">
            <StackPanel>
                <TextBlock Text="Control Panel"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="White" />
                <TextBlock Margin="0,8,0,0"
                           Foreground="#CCCCCC"
                           TextWrapping="Wrap"
                           Text="Phase 2: load a background image and display it on the editor surface." />

                <!-- Button that opens a file picker for supported raster image formats. -->
                <Button Margin="0,16,0,0"
                        Padding="8,6"
                        Content="Load Image..."
                        Click="LoadImageButton_Click" />

                <!-- Displays the currently loaded image path for operator feedback. -->
                <TextBlock x:Name="LoadedImagePathTextBlock"
                           Margin="0,10,0,0"
                           Foreground="#C9E6FF"
                           TextWrapping="Wrap"
                           Text="No image loaded." />
            </StackPanel>
        </Border>

        <!-- Editor surface where the loaded image and overlay layer are rendered. -->
        <Border Grid.Column="1"
                x:Name="EditorSurfaceRegion"
                Margin="12"
                Padding="0"
                Background="#111111"
                BorderBrush="#4A4A4A"
                BorderThickness="1"
                CornerRadius="6">
            <Grid>
                <!-- Image area layer that scales the loaded image while preserving aspect ratio. -->
                <Border Margin="16"
                        x:Name="ImageAreaRegion"
                        Background="#202020"
                        BorderBrush="#3A3A3A"
                        BorderThickness="1"
                        CornerRadius="4">
                    <Grid>
                        <!-- Displays the selected image and keeps it fully visible using Uniform stretch. -->
                        <Image x:Name="BackgroundImage"
                               Stretch="Uniform"
                               SnapsToDevicePixels="True" />

                        <!-- Fallback hint shown only when no image has been selected yet. -->
                        <TextBlock x:Name="EmptyImageHintTextBlock"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="#BFBFBF"
                                   FontSize="16"
                                   Text="Load an image to begin." />
                    </Grid>
                </Border>

                <!-- Overlay placeholder layer rendered above the image area for future phases. -->
                <Border Margin="36"
                        x:Name="OverlayCanvasRegion"
                        BorderBrush="#66FFCC00"
                        BorderThickness="2"
                        CornerRadius="4"
                        IsHitTestVisible="False">
                    <TextBlock HorizontalAlignment="Right"
                               VerticalAlignment="Top"
                               Margin="8"
                               Foreground="#FFD369"
                               FontSize="12"
                               Text="Overlay Canvas (Phase 3)" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
