<Window x:Class="ProjectorLayout.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="ProjectorLayout"
        Height="800"
        Width="1200"
        MinHeight="600"
        MinWidth="900"
        WindowStartupLocation="CenterScreen">
    <!-- Phase 1 scaffold layout only: control panel + image area + overlay canvas regions. -->
    <Grid Background="#1E1E1E">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Control panel placeholder region shown on the left side of the window. -->
        <Border Grid.Column="0"
                x:Name="ControlPanelRegion"
                Margin="12"
                Padding="12"
                Background="#2C2C2C"
                BorderBrush="#4A4A4A"
                BorderThickness="1"
                CornerRadius="6">
            <StackPanel>
                <TextBlock Text="Control Panel"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="White" />
                <TextBlock Margin="0,8,0,0"
                           Foreground="#CCCCCC"
                           TextWrapping="Wrap"
                           Text="Phase 1 scaffold: controls will be added in later phases." />
            </StackPanel>
        </Border>

        <!-- Editor surface placeholder on the right where image and overlay layers are stacked. -->
        <Border Grid.Column="1"
                x:Name="EditorSurfaceRegion"
                Margin="12"
                Padding="0"
                Background="#111111"
                BorderBrush="#4A4A4A"
                BorderThickness="1"
                CornerRadius="6">
            <Grid>
                <!-- Image area placeholder layer. -->
                <Border Margin="16"
                        x:Name="ImageAreaRegion"
                        Background="#202020"
                        BorderBrush="#3A3A3A"
                        BorderThickness="1"
                        CornerRadius="4">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="#BFBFBF"
                               FontSize="16"
                               Text="Image Area (Phase 2)" />
                </Border>

                <!-- Overlay canvas placeholder layer rendered above the image area. -->
                <Border Margin="36"
                        x:Name="OverlayCanvasRegion"
                        BorderBrush="#66FFCC00"
                        BorderThickness="2"
                        CornerRadius="4"
                        IsHitTestVisible="False">
                    <TextBlock HorizontalAlignment="Right"
                               VerticalAlignment="Top"
                               Margin="8"
                               Foreground="#FFD369"
                               FontSize="12"
                               Text="Overlay Canvas (Phase 3)" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
